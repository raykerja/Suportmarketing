    {
      "id": "86d46109-5e06-48f5-9f69-76df8ad13934",
      "name": "Susun Backup JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const base = $('Validasi Kunjungan').first().json;\nconst sheet = $input.first().json;\nconst photoId = $('Susun Baris Sheet').first().json.photo_drive_file_id || null;\nconst existing = base.backup_drive_file_id && /^[A-Za-z0-9_-]{10,200}$/.test(base.backup_drive_file_id) ? base.backup_drive_file_id : null;\nif (!base.drive_folder_id && !existing) return [{json: {mode: 'skip', visit_id: base.visit_id}}];\nconst body = {backup_versi: 1, id_laporan: base.visit_id, email_marketing: base.email,\n  dicadangkan_pada: new Date().toISOString(), baris_sheet: sheet.row_number || null,\n  foto_drive_url: photoId ? `https://drive.google.com/file/d/${photoId}/view` : null, data_kunjungan: base.visit, riwayat_progres: base.progress_events || []};\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(JSON.stringify(body, null, 2), 'utf8'),\n  `Backup_Kunjungan_${base.visit_id}.json`, 'application/json');\nreturn [{json: {mode: existing ? 'update' : 'create', visit_id: base.visit_id, file_id: existing}, binary: {data: binary}}];\n"
      }
    },
