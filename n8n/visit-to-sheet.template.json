      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nif ((input.headers || {})['x-ray-secret'] !== \"SET_MARKETING_WEBHOOK_SECRET\") throw new Error('Unauthorized');\nconst b = input.body || {};\nif (!/^[0-9a-f-]{36}$/i.test(String(b.visit_id || '')) || !b.visit ||\n    (b.photo_url && !/^https:\\/\\/ewicmiekwzmxkkokmpzf\\.supabase\\.co\\//.test(String(b.photo_url))) ||\n    (b.drive_folder_id && !/^[A-Za-z0-9_-]{10,200}$/.test(String(b.drive_folder_id))))\n  throw new Error('Data laporan tidak valid');\nreturn [{json:{visit_id:String(b.visit_id), visit:b.visit, email:String(b.email || ''),\n  photo_url:b.photo_url || null, photo_drive_file_id:b.photo_drive_file_id || null,\n  drive_folder_id:b.drive_folder_id || null}}];\n"
      }
    },
    {
      "id": "ebb578f0-de0c-455e-a423-2102f4cf2ce3",
      "name": "Respons Kunjungan Diterima",
